#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @ASC_VERSION_MAJOR@,@ASC_VERSION_MINOR@,@ASC_VERSION_PATCH@,0
 PRODUCTVERSION @ASC_VERSION_MAJOR@,@ASC_VERSION_MINOR@,@ASC_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @ASC_VERSION_FILE_TYPE@
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "@ASC_VERSION_DESCRIPTION@\0"
            VALUE "FileVersion", "@ASC_PACKAGE_VERSION@\0"
            VALUE "InternalName", "@ASC_VERSION_INTERNAL_NAME@\0"
            VALUE "OriginalFilename", "@ASC_VERSION_ORIGINAL_FILENAME@\0"
            VALUE "ProductName", "Automatic Screen Camera\0"
            VALUE "ProductVersion", "@ASC_PACKAGE_VERSION@\0"
#ifdef _DEBUG
            VALUE "Comments", "Source revision @ASC_SOURCE_REVISION@; Debug; x64; Windows SDK 10.0.22621.0\0"
#else
            VALUE "Comments", "Source revision @ASC_SOURCE_REVISION@; Release; x64; Windows SDK 10.0.22621.0\0"
#endif
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
